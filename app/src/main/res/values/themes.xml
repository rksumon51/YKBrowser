<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One coherent Material 3 DayNight theme for every screen. -->
    <style name="Theme.YKBrowser" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/browser_primary</item>
        <item name="colorOnPrimary">@color/browser_on_primary</item>
        <item name="colorPrimaryContainer">@color/browser_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/browser_on_primary_container</item>
        <item name="colorSecondary">@color/browser_secondary</item>
        <item name="colorSurface">@color/browser_surface</item>
        <item name="colorOnSurface">@color/browser_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/browser_text_secondary</item>
        <item name="colorSurfaceVariant">@color/browser_surface_container</item>
        <item name="colorSurfaceContainer">@color/browser_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/browser_surface_container_high</item>
        <item name="colorOutline">@color/browser_divider</item>
        <item name="colorError">@color/browser_error</item>
        <item name="android:statusBarColor">@color/browser_bg</item>
        <item name="android:windowLightStatusBar">@bool/is_light_status_bar</item>
        <item name="android:navigationBarColor">@color/browser_bg</item>
        <item name="android:windowLightNavigationBar">@bool/is_light_status_bar</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.YKBrowser.BottomSheetDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.YKBrowser.Dialog</item>
    </style>

    <!-- Rounded top corners for bottom sheets (tab switcher). -->
    <style name="ThemeOverlay.YKBrowser.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.YKBrowser.BottomSheet</item>
    </style>

    <style name="Widget.YKBrowser.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.YKBrowser.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.YKBrowser.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Rounded Material 3 dialogs (PIN dialogs). -->
    <style name="ThemeOverlay.YKBrowser.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearance">@style/ShapeAppearance.YKBrowser.Dialog</item>
    </style>

    <style name="ShapeAppearance.YKBrowser.Dialog" parent="ShapeAppearance.Material3.ExtraLargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
</resources>
