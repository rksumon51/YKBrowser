<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Reusable YKBrowser component styles (12dp button corners, 20dp cards). -->
    <style name="Widget.YKBrowser.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.YKBrowser.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.YKBrowser.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.YKBrowser.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
